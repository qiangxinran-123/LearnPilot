# Example only. Do not put production credentials in this file.
APP_ENV=development
# Safe local Demo database. Set DATABASE_URL explicitly in your private .env.
DATABASE_URL=sqlite+pysqlite:///./learnpilot-demo.sqlite3
# MySQL 8.x deployment example (configure real credentials only in .env):
# DATABASE_URL=mysql+pymysql://learnpilot:change-me@127.0.0.1:3306/learnpilot
UPLOAD_ROOT=backend/app/uploads
MAX_UPLOAD_BYTES=20971520
LOG_LEVEL=INFO
LEGACY_BOOTSTRAP_USER=legacy-bootstrap@learnpilot.local
LEGACY_BOOTSTRAP_USER_DISPLAY_NAME=Legacy CampusAI

# LLM provider configuration. Keep LLM_MODE=provider for real calls.
# Use LLM_MODE=mock only for explicit local tests; it is not a production fallback.
LLM_MODE=provider
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=2
LLM_CONTEXT_CHARS=12000
LLM_CHUNK_CHARS=800
LLM_CHUNK_OVERLAP_CHARS=120
LLM_SUMMARY_MAX_CHUNKS=8
LLM_SUMMARY_MAX_INPUT_CHARS=200000
